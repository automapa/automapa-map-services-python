# Copy this file to .env and fill in your credentials.
# The .env file is listed in .gitignore and must NOT be committed.

# Required for integration tests
AUTOMAPA_API_KEY=your_api_key_here
AUTOMAPA_API_PASSWORD=your_api_password_here

# Optional: comma-separated list of endpoint suite names that MUST pass
# (tests for other suites will be skipped on permission errors instead of failing)
# Available values: geocoder, autocomplete, road, road_permit, routes, speed, session, ping_pong
AUTOMAPA_API_REQUIRED_ACCESS=
